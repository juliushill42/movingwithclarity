[Unit]
Description=CLARITY Movers stack (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Edit this path to match wherever deploy.sh cloned the repo (deploy.sh's
# own output prints the resolved path at the end of the run).
WorkingDirectory=/home/julius/Clarity-movers/clarity-movers
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
